# proxmox-server VMs — source: proxmox.tfvars + modules/*/cloud-init.yaml
# Usage: append to ~/.ssh/config (chmod 600), then `ssh llm`, `ssh postgres`, ...

Host pve proxmox
    HostName 192.168.51.200
    User root
    # root@pam does not accept ~/.ssh/proxmox-ubuntu or ~/.ssh/id_ed25519 -> password auth

Host llm
    HostName 192.168.51.201
    User llm
    IdentityFile ~/.ssh/proxmox-ubuntu
    IdentitiesOnly yes

Host jenkins
    HostName 192.168.51.202
    User jenkins
    IdentityFile ~/.ssh/proxmox-ubuntu
    IdentitiesOnly yes

# NOTE: this VM's cloud-init installs ~/.ssh/jenkins-agent.pub (user is still "jenkins")
Host jenkins-agent
    HostName 192.168.51.203
    User jenkins
    IdentityFile ~/.ssh/jenkins-agent
    IdentitiesOnly yes

Host openwebui open-webui
    HostName 192.168.51.204
    User openwebui
    IdentityFile ~/.ssh/proxmox-ubuntu
    IdentitiesOnly yes

