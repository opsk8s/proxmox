{
  "uid": "proxmox-nginx",
  "title": "Proxmox — NGINX Proxy",
  "tags": [
    "proxmox",
    "nginx"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "NGINX proxy reachable",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        { "expr": "max(probe_success{job=\"blackbox\", instance=~\".*:80/\"})", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "NGINX node up",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        { "expr": "up{job=\"nodes\", instance_name=\"nginx\"}", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Requests (range)",
      "datasource": {
        "type": "elasticsearch",
        "uid": "elasticsearch"
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        { "query": "| from \"nginx-access-*\" | stats cnt = count()", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Avg request time (s)",
      "datasource": {
        "type": "elasticsearch",
        "uid": "elasticsearch"
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        { "query": "| from \"nginx-access-*\" | stats avg_req = avg(request_time)", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request rate (all virtual hosts)",
      "datasource": {
        "type": "elasticsearch",
        "uid": "elasticsearch"
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        { "query": "| from \"nginx-access-*\" | stats cnt = count() by ts = histogram(@timestamp, interval: auto())", "refId": "A" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Response time (s)",
      "datasource": {
        "type": "elasticsearch",
        "uid": "elasticsearch"
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        { "query": "| from \"nginx-access-*\" | stats avg = avg(request_time), mx = max(request_time) by ts = histogram(@timestamp, interval: auto())", "refId": "A" }
      ]
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "Requests by virtual host",
      "datasource": {
        "type": "elasticsearch",
        "uid": "elasticsearch"
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 70
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "orientation": "horizontal",
        "tooltip": { "mode": "single" },
        "xTickLabelRotation": 0
      },
      "targets": [
        { "query": "| from \"nginx-access-*\" | stats cnt = count() by host | sort cnt desc | head 10", "refId": "A" }
      ]
    },
    {
      "id": 8,
      "type": "barchart",
      "title": "Status codes",
      "datasource": {
        "type": "elasticsearch",
        "uid": "elasticsearch"
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 70
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "orientation": "horizontal",
        "tooltip": { "mode": "single" },
        "xTickLabelRotation": 0
      },
      "targets": [
        { "query": "| from \"nginx-access-*\" | stats cnt = count() by status | sort status asc", "refId": "A" }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Slowest requests",
      "datasource": {
        "type": "elasticsearch",
        "uid": "elasticsearch"
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "request_time" },
            "properties": [
              { "id": "unit", "value": "s" }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": { "show": false }
      },
      "targets": [
        { "query": "| from \"nginx-access-*\" | sort request_time desc | head 10 | keep request, host, status, request_time, upstream_addr", "refId": "A" }
      ]
    }
  ]
}
