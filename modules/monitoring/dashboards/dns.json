      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{instance_name=\"dns\"} / node_memory_MemTotal_bytes{instance_name=\"dns\"})",
          "legendFormat": "{{instance_name}}",
          "refId": "A"
        }
      ]
    },
