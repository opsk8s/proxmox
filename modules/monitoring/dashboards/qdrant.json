      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": null,
          "max": null
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "process_threads",
          "legendFormat": "threads",
          "refId": "A"
        },
        {
          "expr": "process_open_fds",
          "legendFormat": "open fds",
          "refId": "B"
        },
        {
          "expr": "process_max_fds",
          "legendFormat": "max fds",
          "refId": "C"
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Slowest REST endpoints (avg over 5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Avg (s)"
              },
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "showTypeIcons": false,
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false
        },
        "sortBy": [
          {
            "displayName": "Value #A",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "expr": "topk(10, sum by (method, endpoint) (rate(rest_responses_duration_seconds_sum[5m])) / sum by (method, endpoint) (rate(rest_responses_total[5m])))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    }
  ]
