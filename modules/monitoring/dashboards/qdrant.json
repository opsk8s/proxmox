          "min": null,
          "max": null
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "memory_resident_bytes",
          "legendFormat": "resident",
          "refId": "A"
        },
        {
          "expr": "memory_allocated_bytes",
          "legendFormat": "allocated",
          "refId": "B"
        },
        {
          "expr": "memory_retained_bytes",
          "legendFormat": "retained",
          "refId": "C"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Process",
      "datasource": {
        "type": "prometheus",
