  "templating": {
    "list": [
      {
        "name": "card",
        "label": "GPU",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(amdgpu_gpu_utilization_percent, card)",
          "refId": "StandardFromQuery"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
