[
  {
    "viz_id": "nginx-request-rate",
    "title": "Request rate",
    "description": "all proxied requests per time bucket (json_analytics access log)",
    "chart": "area",
    "filters": [],
    "metrics": [
      { "type": "count", "label": "requests" }
    ]
  },
  {
    "viz_id": "nginx-response-time",
    "title": "Response time (s)",
    "description": "avg/max nginx request_time across all virtual hosts",
    "chart": "line",
    "filters": [],
    "metrics": [
      { "type": "avg", "field": "request_time", "label": "avg s" },
      { "type": "max", "field": "request_time", "label": "max s" }
    ]
  },
  {
    "viz_id": "nginx-upstream-time",
    "title": "Upstream response time (s)",
    "description": "avg upstream_response_time (time spent in the backend service)",
    "chart": "line",
    "filters": [],
    "metrics": [
      { "type": "avg", "field": "upstream_response_time", "label": "avg s" },
      { "type": "max", "field": "upstream_response_time", "label": "max s" }
    ]
  },
  {
    "viz_id": "nginx-bytes-sent",
    "title": "Bytes sent",
    "description": "total body_bytes_sent per time bucket (bytes)",
    "chart": "area",
    "filters": [],
    "metrics": [
      { "type": "sum", "field": "body_bytes_sent", "label": "bytes" }
    ]
  },
  {
    "viz_id": "nginx-request-rate-instance",
    "title": "Requests per LLM instance",
    "description": "requests to app.llm.lan per upstream instance (llm_pool round-robin; upstream_addr ip:port)",
    "chart": "area",
    "filters": [
      { "field": "host.keyword", "value": "app.llm.lan" }
    ],
    "splits": [
      { "field": "upstream_addr.keyword" }
    ],
    "metrics": [
      { "type": "count", "label": "requests" }
    ]
  },
  {
    "viz_id": "nginx-response-time-instance",
    "title": "Response time per LLM instance (s)",
    "description": "avg/max nginx request_time per upstream instance serving app.llm.lan",
    "chart": "line",
    "filters": [
      { "field": "host.keyword", "value": "app.llm.lan" }
    ],
    "splits": [
      { "field": "upstream_addr.keyword" }
    ],
    "metrics": [
      { "type": "avg", "field": "request_time", "label": "avg s" },
      { "type": "max", "field": "request_time", "label": "max s" }
    ]
  }
]
