[
  {
    "viz_id": "flow-requests-instance",
    "title": "LLM requests per instance",
    "description": "requests to app.llm.lan per upstream instance (upstream_addr ip:port; the port is the llama-server instance serving it)",
    "chart": "area",
    "data_view": "nginx-access-data-view",
    "filters": [
      { "field": "host.keyword", "value": "app.llm.lan" }
    ],
    "splits": [
      { "field": "upstream_addr.keyword" }
    ],
    "metrics": [
      { "type": "count", "label": "requests" }
    ]
  },
  {
    "viz_id": "flow-latency-instance",
    "title": "Request latency per instance (s)",
    "description": "avg/max nginx request_time per upstream instance (queue + generation + streaming time)",
    "chart": "line",
    "data_view": "nginx-access-data-view",
    "filters": [
      { "field": "host.keyword", "value": "app.llm.lan" }
    ],
    "splits": [
      { "field": "upstream_addr.keyword" }
    ],
    "metrics": [
      { "type": "avg", "field": "request_time", "label": "avg s" },
      { "type": "max", "field": "request_time", "label": "max s" }
    ]
  },
  {
    "viz_id": "flow-errors-5xx",
    "title": "LLM 5xx errors",
    "description": "proxy/upstream failures on app.llm.lan (status 5xx)",
    "chart": "area",
    "data_view": "nginx-access-data-view",
    "filters": [
      { "field": "host.keyword", "value": "app.llm.lan" },
      { "field": "status", "value": "[500 TO 599]" }
    ],
    "metrics": [
      { "type": "count", "label": "errors" }
    ]
  },
  {
    "viz_id": "flow-body-bytes",
    "title": "Captured body bytes streamed",
    "description": "response bytes of captured LLM JSON API calls (nginx-body-*; one record per request, linked to nginx-access by request_id)",
    "chart": "area",
    "data_view": "nginx-body-data-view",
    "filters": [],
    "metrics": [
      { "type": "sum", "field": "response_body_bytes", "label": "bytes" }
    ]
  },
  {
    "viz_id": "flow-completions-instance",
    "title": "Completed generations per instance",
    "description": "finished generations (total_time events) per llama-server instance; instance = upstream port",
    "chart": "area",
    "data_view": "llm-logs-data-view",
    "filters": [
      { "field": "llama.event.keyword", "value": "total_time" }
    ],
    "splits": [
      { "field": "instance" }
    ],
    "metrics": [
      { "type": "count", "label": "completions" }
    ]
  },
  {
    "viz_id": "flow-throughput-instance",
    "title": "Generation throughput per instance (t/s)",
    "description": "avg generation t/s from slot progress lines, per llama-server instance",
    "chart": "line",
    "data_view": "llm-logs-data-view",
    "filters": [
      { "field": "llama.event.keyword", "value": "slot_progress" }
    ],
    "splits": [
      { "field": "instance" }
    ],
    "metrics": [
      { "type": "avg", "field": "tg_tps", "label": "avg t/s" }
    ]
  }
]
