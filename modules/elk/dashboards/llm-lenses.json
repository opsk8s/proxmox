[
  {
    "type": "xy",
    "title": "Generation throughput (tokens/s)",
    "description": "avg/max generation t/s from slot progress lines",
    "filters": [
      { "type": "condition", "condition": { "field": "llama.event.keyword", "operator": "is", "value": "slot_progress" } },
      { "type": "condition", "condition": { "field": "source.keyword", "operator": "is", "value": "llama" } }
    ],
    "layers": [
      {
        "type": "line",
        "data_source": { "type": "data_view_spec", "index_pattern": "llm-logs-*", "time_field": "@timestamp" },
        "x": { "operation": "date_histogram", "field": "@timestamp" },
        "y": [
          { "operation": "average", "field": "tg_tps", "label": "avg t/s" },
          { "operation": "max", "field": "tg_tps", "label": "max t/s" }
        ]
      }
    ]
  },
  {
    "type": "xy",
    "title": "Completed generations",
    "description": "one total_time event per finished slot generation",
    "filters": [
      { "type": "condition", "condition": { "field": "llama.event.keyword", "operator": "is", "value": "total_time" } },
      { "type": "condition", "condition": { "field": "source.keyword", "operator": "is", "value": "llama" } }
    ],
    "layers": [
      {
        "type": "area",
        "data_source": { "type": "data_view_spec", "index_pattern": "llm-logs-*", "time_field": "@timestamp" },
        "x": { "operation": "date_histogram", "field": "@timestamp" },
        "y": [
          { "operation": "count", "label": "completions" }
        ]
      }
    ]
  },
  {
    "type": "xy",
    "title": "Prompt processing (tokens/s)",
    "description": "prompt prefill throughput from prompt-progress samples",
    "filters": [
      { "type": "condition", "condition": { "field": "llama.event.keyword", "operator": "is", "value": "prompt_progress" } },
      { "type": "condition", "condition": { "field": "source.keyword", "operator": "is", "value": "llama" } }
    ],
    "layers": [
      {
        "type": "line",
        "data_source": { "type": "data_view_spec", "index_pattern": "llm-logs-*", "time_field": "@timestamp" },
        "x": { "operation": "date_histogram", "field": "@timestamp" },
        "y": [
          { "operation": "average", "field": "prompt_proc_tps", "label": "avg prompt t/s" }
        ]
      }
    ]
  }
]
